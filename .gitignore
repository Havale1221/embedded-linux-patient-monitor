
from flask import Flask, render_template_string
from datetime import datetime

app = Flask(__name__)

PAGE = """
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Patient Monitor</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0; background: #101827; color: white;
  font-family: Arial, sans-serif; text-align: center;
}
header { padding: 14px; font-size: 24px; font-weight: bold; }
.panels {
  display: flex; flex-wrap: wrap; min-height: 85vh;
}
.panel {
  flex: 1; min-width: 280px; padding: 24px 12px;
}
.oxygen { background: #08bfc9; }
.pulse { background: linear-gradient(#ff7139, #f52243); }
.gauge {
  width: 230px; height: 230px; max-width: 85%;
  border: 12px solid rgba(255,255,255,.8);
  border-radius: 50%; margin: 22px auto;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  box-shadow: 0 0 10px #ffffff44;
}
.value { font-size: 55px; font-weight: bold; }
.unit { font-size: 18px; }
canvas { width: 95%; max-width: 460px; height: 130px; }
footer { padding: 12px; font-size: 12px; }
</style>
</head>
<body>
<header>Patient Health Monitoring</header>
<div class="panels">
  <section class="panel oxygen">
    <h2>OXYGEN</h2>
    <div class="gauge">
      <div>SpO₂</div>
      <div class="value">{{ spo2 }}<span class="unit">%</span></div>
    </div>
    <canvas id="oxygenChart"></canvas>
  </section>
  <section class="panel pulse">
    <h2>PULSE</h2>
    <div class="gauge">
      <div>♡ BPM</div>
      <div class="value">{{ pulse }}</div>
    </div>
    <canvas id="pulseChart"></canvas>
  </section>
</div>
<footer>
  Updated: {{ updated }} | Demonstration readings only — not for diagnosis.
</footer>
<script>
function drawChart(id, values) {
  const c = document.getElementById(id);
  const ctx = c.getContext("2d");
  c.width = c.clientWidth;
  c.height = 130;
  ctx.strokeStyle = "rgba(255,255,255,.35)";
  ctx.lineWidth = 1;
  for (let y = 20; y < 130; y += 30) {
    ctx.beginPath(); ctx.moveTo(0,y);
    ctx.lineTo(c.width,y); ctx.stroke();
  }
  ctx.strokeStyle = "white"; ctx.lineWidth = 2;
  ctx.beginPath();
  values.forEach((v,i) => {
    const x = i * c.width / (values.length - 1);
    const y = 65 - (v - 50) * 1.1;
    if (i === 0) ctx.moveTo(x,y);
    else ctx.lineTo(x,y);
  });
  ctx.stroke();
}
drawChart("oxygenChart",
  [89,91,90,94,92,95,93,96,94,98]);
drawChart("pulseChart",
  [70,74,72,78,75,81,76,73,79,75]);
</script>
</body>
</html>
"""

@app.route("/")
def home():
    return render_template_string(
        PAGE,
        spo2=98,
        pulse=75,
        updated=datetime.now().strftime("%H:%M:%S")
    )

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=False)
